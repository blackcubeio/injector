{
    "name": "blackcube/injector",
    "description": "Static PSR-11 container accessor — get DI everywhere",
    "keywords": [
        "di",
        "injector",
        "psr-11",
        "container"
    ],
    "type": "library",
    "license": "BSD-3-Clause",
    "readme": "README.md",
    "homepage": "https://github.com/blackcubeio/injector",
    "support": {
        "issues": "https://github.com/blackcubeio/injector/issues",
        "source": "https://github.com/blackcubeio/injector"
    },
    "authors": [
        {
            "name": "Philippe Gaultier",
            "email": "philippe@blackcube.io"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "psr/container": "^2.0",
        "yiisoft/factory": "^1.3"
    },
    "require-dev": {
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.3",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "Blackcube\\Injector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blackcube\\Injector\\Tests\\": "tests"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-devel": "1.x-dev"
        },
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true
    }
}
